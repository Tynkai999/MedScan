{
  "realm": "medscan",
  "enabled": true,
  "displayName": "MedScan Enterprise Realm",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "PATIENT", "description": "Patient usager du système de soins" },
      { "name": "DOCTOR", "description": "Médecin praticien (généraliste / spécialiste)" },
      { "name": "RADIOLOGIST", "description": "Médecin radiologue ou spécialiste imagerie" },
      { "name": "NURSE", "description": "Infirmier / soignant" },
      { "name": "LAB_TECHNICIAN", "description": "Technicien de laboratoire d'analyses" },
      { "name": "PHARMACIST", "description": "Pharmacien d'officine" },
      { "name": "DELIVERY_AGENT", "description": "Agent de livraison pharmaceutique" },
      { "name": "TENANT_ADMIN", "description": "Administrateur d'établissement de santé" },
      { "name": "SUPER_ADMIN", "description": "Super-administrateur de la plateforme MedScan" },
      { "name": "AUDITOR", "description": "Auditeur de sécurité / DPO" }
    ]
  },
  "clients": [
    {
      "clientId": "medscan-backend",
      "name": "MedScan Jakarta EE Backend",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "medscan-mobile",
