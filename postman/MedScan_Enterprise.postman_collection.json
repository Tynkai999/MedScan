    {
      "name": "03 - Portails Métier des Acteurs (RBAC)",
      "item": [
        {
          "name": "Portail Pharmacie (GET /v1/portal/pharmacist)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('pharmacist_token')) {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('base_url') + '/v1/auth/login',",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: { mode: 'raw', raw: JSON.stringify({ username: 'pharmacist@medscan.org', password: 'Password123!' }) }",
                  "    }, function (err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            pm.collectionVariables.set('pharmacist_token', res.json().accessToken);",
                  "        }",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
